# /etc/exact-forwarder/env  (root:root, mode 600; systemd reads it before dropping privileges)
# Never commit the filled-in version.

# --- required -------------------------------------------------------------
MAIL_ACCOUNT=invoices@example.com
# Google account app password (Google Account > Security > App passwords). Not your normal password.
MAIL_PASSWORD=
# Your administration's scan address(es), shown in Exact Online under the "Scan & Herken" settings.
EXACT_PURCHASE_ADDRESS=yourcode@inkoop.exactonline.nl
# EXACT_SALES_ADDRESS=yourcode@verkoop.exactonline.nl

# --- notifications (at least one channel outside DRY_RUN) -----------------
NOTIFY_EMAIL=bookkeeping@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- recognising unknown senders -------------------------------------------
# Comma-separated names that appear on invoices addressed to you. Without it,
# unknown senders are always sent for review.
OWN_NAMES=example b.v.
# OWN_DOMAINS=example.com          (default: the domain of MAIL_ACCOUNT)

# --- start safe --------------------------------------------------------------
# DRY_RUN=1 only logs decisions (counts, no content) and sends nothing. Remove it to go live.
DRY_RUN=1

# --- optional (defaults in brackets) -----------------------------------------
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_FROM_NAME=exact-forwarder
# AUTHSERV_ID=mx.google.com        (who stamps Authentication-Results on incoming mail)
# MAX_PER_RUN=10                   (more forwards in one run = send nothing and raise an alarm)
# LOOKBACK_DAYS=14
# SUMMARY_AT=20:00                 (Europe/Amsterdam)
# GMAIL_LABELS=1                   (0 = do not add the label "Exact/doorgestuurd")
# LEGACY_EXACT_ADDRESSES=          (older scan addresses, only used by `seed` to recognise past sends)
# DRY_RUN_SINCE=2026-01-01T00:00:00Z
# DRY_RUN_IGNORE_STATE=1
