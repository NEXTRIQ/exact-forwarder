{
  "name": "exact-forwarder",
  "version": "1.0.0",
  "private": true,
  "description": "Forwards recognised invoices from a Gmail / Google Workspace mailbox to Exact Online. Deterministic rules, no AI.",
  "license": "MIT",
  "author": "NEXTRIQ",
  "repository": {
    "type": "git",
    "url": "https://github.com/NEXTRIQ/exact-forwarder.git"
  },
  "keywords": ["exact-online", "invoices", "bookkeeping", "gmail", "imap", "automation"],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "exact-forwarder": "bin/exact-forwarder.mjs"
  },
  "scripts": {
    "start": "node bin/exact-forwarder.mjs",
    "dry-run": "DRY_RUN=1 node bin/exact-forwarder.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "imapflow": "1.4.0",
    "nodemailer": "8.0.10"
  }
}
